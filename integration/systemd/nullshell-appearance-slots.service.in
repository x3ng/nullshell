[Unit]
Description=Provision per-user nullshell greeter appearance slots
DefaultDependencies=no
After=systemd-tmpfiles-setup.service
Before=greetd.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@HELPER@ ensure-appearance-slot --create --local

[Install]
WantedBy=multi-user.target
