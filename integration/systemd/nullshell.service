[Unit]
Description=nullshell desktop
PartOf=nullshell-session.target graphical-session.target
Wants=darkman.service
After=graphical-session.target darkman.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecCondition=/bin/sh -c 'test -n "$HYPRLAND_INSTANCE_SIGNATURE" && test -n "$WAYLAND_DISPLAY"'
ExecStart=@BINDIR@/nullshell desktop --no-duplicate
Restart=on-failure
RestartSec=2
