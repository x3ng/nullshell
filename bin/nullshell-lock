#!/bin/sh
set -eu
[ -e /etc/pam.d/nullshell-lock ] || { echo 'nullshell-lock PAM service is missing' >&2; exit 1; }
resources=${NULLSHELL_DATA_DIR:?The nullshell launcher must provide the resource directory}
request() { [ "$(timeout 1s quickshell ipc --path "$resources/lock/shell.qml" call locker lock 2>/dev/null)" = locked ]; }
if ! request; then
    timeout 5s systemctl --user start nullshell-lock.service
    accepted=false
    for attempt in $(seq 1 50); do
        if request; then accepted=true; break; fi
        sleep 0.1
    done
    "$accepted" || { echo 'Locker did not accept the request' >&2; exit 1; }
fi
# A successful request is not yet a secured Wayland session.
for attempt in $(seq 1 50); do
    if timeout 1s quickshell ipc --path "$resources/lock/shell.qml" call locker status 2>/dev/null | grep -q '"secure":true'; then exit 0; fi
    sleep 0.1
done
echo 'Compositor did not confirm a secured lock' >&2
exit 1
